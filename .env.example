# Copy to .env.local and edit if needed.
# This is a local/LAN proxy key, not a vendor API key.
# Generate a strong one:  python -c "import secrets;print('sk-local-'+secrets.token_urlsafe(36))"
LOCAL_LITELLM_MASTER_KEY=sk-local-CHANGE-ME-generate-a-strong-key

# Optional: change when repointing the proxy to DGX tomorrow.
LOCAL_BACKEND_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_PRIMARY_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
LOCAL_FAST_MODEL=Qwen/Qwen3-32B-AWQ

# Optional: self-hosted Langfuse on Dell :3100 (copy to .env.langfuse or .env.local).
# Do not point these at Langfuse Cloud. start_proxy.sh defaults LANGFUSE_OTEL_HOST
# to http://127.0.0.1:3100 when unset so traces stay on the tower.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_OTEL_HOST=http://127.0.0.1:3100
